# Webhook para alertas (Slack/Teams/Zapier). Opcional.
ALERT_WEBHOOK_URL=

# Correo para alertas (requiere comando `mail` instalado). Opcional.
ALERT_EMAIL=

# Umbrales opcionales en milisegundos.
API_HEALTH_MAX_MS=300
AUTH_LOGIN_MAX_MS=1200
DASHBOARD_MAX_MS=2500
MAX_ATTEMPTS=2
RETRY_SLEEP_SECONDS=1
