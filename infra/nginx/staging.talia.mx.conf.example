# Nginx server block sugerido para staging.talia.mx
server {
    server_name staging.talia.mx;

    # En staging de panel, dejamos que Next.js maneje todo (incluyendo /api/auth/*)
    # y que éste llame al backend via PANEL_API_URL interno (8104).
    location / {
        proxy_pass http://127.0.0.1:3101;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
    }
}
