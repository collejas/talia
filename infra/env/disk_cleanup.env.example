# Retencion de releases por ambiente
KEEP_PROD_RELEASES=1
KEEP_STG_RELEASES=1

# Retencion de backups locales postgres_*
KEEP_BACKUPS=2

# Retencion de journals (systemd)
JOURNAL_VACUUM_TIME=10d

# Retencion de logs locales .log y .log.*
KEEP_LOG_DAYS=7

# Toggles de limpieza
RUN_TOOL_CACHE_CLEAN=1
RUN_NEXT_CACHE_CLEAN=1
RUN_RELEASE_ARTIFACT_CLEAN=1
RUN_LOCAL_PACKAGE_CACHE_CLEAN=1
RUN_NPM_CACHE_CLEAN=1
RUN_GIT_GC=1

# 1 para simular sin borrar
DRY_RUN=0
