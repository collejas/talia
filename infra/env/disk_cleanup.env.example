# Retencion de releases por ambiente
KEEP_PROD_RELEASES=1
KEEP_STG_RELEASES=1

# Retencion de backups locales postgres_*
KEEP_BACKUPS=2

# Retencion de journals (systemd)
JOURNAL_VACUUM_TIME=10d

# Retencion de logs locales .log y .log.* en logs/ y archivos sueltos de nivel raiz
KEEP_LOG_DAYS=2

# Purga explicita de logs rotados. 1 borra .log.*, .out y .err aunque no hayan vencido.
# KEEP_CURRENT_LOGS=1 conserva los .log activos; ponlo en 0 para borrar todo el historico.
RUN_LOGS_PURGE=0
KEEP_CURRENT_LOGS=1

# Limpieza de logs de usuario
RUN_USER_LOG_CLEAN=1
USER_HOME_DIRS=/home/jorge
RUN_USER_NPM_CACHE_CLEAN=1
RUN_USER_PLAYWRIGHT_CACHE_CLEAN=1
RUN_USER_GO_CACHE_CLEAN=1
RUN_VSCODE_SERVER_PRUNE=1
VSCODE_SERVER_KEEP_VERSIONS=1

# Toggles de limpieza
RUN_TOOL_CACHE_CLEAN=1
RUN_NEXT_CACHE_CLEAN=1
RUN_RELEASE_ARTIFACT_CLEAN=1
RUN_LOCAL_PACKAGE_CACHE_CLEAN=1
RUN_NPM_CACHE_CLEAN=1
RUN_GIT_GC=1

# 1 para simular sin borrar
DRY_RUN=0
